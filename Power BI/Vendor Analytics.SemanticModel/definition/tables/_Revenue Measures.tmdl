table '_Revenue Measures'
	lineageTag: a14b4fd6-cc08-4135-9ba8-f21ea182de39

	measure 'Total Revenue' = SUM(Vendor_Revenue[TotalRevenue])
		formatString: \$#,0
		lineageTag: c8d5c9e4-6786-4e19-9fd5-bfd20ee11842

		changedProperty = IsHidden

	measure 'Total Gross Profit' = SUM(Vendor_Revenue[TotalGrossProfit])
		formatString: \$#,0
		lineageTag: 70399a2d-edc1-4e7e-bee3-fdc929f7cc03

		changedProperty = IsHidden

	measure 'Avg Profit Margin %' = AVERAGE(Vendor_Revenue[AvgMarginPct])
		lineageTag: 4cb4ff83-977e-4790-939d-71c7357bb40c

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Vendors' = DISTINCTCOUNT(Vendor_Revenue[VendorName])
		formatString: 0
		lineageTag: 630503d2-fe0e-431f-a570-ec0bdd69cd3e

		changedProperty = IsHidden

	measure 'Total SKUs' = SUM(Vendor_Revenue[NumberOfSKUs])
		formatString: 0
		lineageTag: 5764cdf4-32d6-42ec-b168-79d9a8de5942

		changedProperty = IsHidden

	measure 'Blended Margin %' =
			
			DIVIDE(
			    SUM(Vendor_Revenue[TotalGrossProfit]),
			    SUM(Vendor_Revenue[TotalRevenue]),
			    0
			)
		formatString: 0.0%
		lineageTag: 8a0cb035-9d77-47f0-a34e-d347462e7eb2

	measure 'SKUs by Health Category' = ```
			
			COUNTROWS(vw_PortfolioHealth)
			
			```
		formatString: 0
		lineageTag: 0d2da818-9e4d-4794-bbe7-9d3ccab73026

	column Dummy
		dataType: string
		isHidden
		lineageTag: 18ae9a52-8084-4cb0-bc83-c47e4224fa56
		summarizeBy: none
		sourceColumn: Dummy

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

