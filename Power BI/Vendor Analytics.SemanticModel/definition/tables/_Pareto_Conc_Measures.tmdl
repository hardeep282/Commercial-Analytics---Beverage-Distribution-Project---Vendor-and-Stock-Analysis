table _Pareto_Conc_Measures
	lineageTag: 4e1ec1e6-1eaf-467c-9707-ac400d04bae1

	measure 'Top 10 Vendor Revenue' = ```
			CALCULATE(SUM(Pareto_Analysis[TotalRevenue]),
			                                  TOPN(10, 
			                                      ALL(Pareto_Analysis),
			                                      Pareto_Analysis[TotalRevenue],
			                                      DESC
			                                      )
			                                    )
			```
		formatString: \$#,0
		lineageTag: db3d2bd2-7c9d-4288-bf1f-b813f84bbc83

	measure 'Top 10 Revenue Concentration %' =
			// Share of total portfolio revenue from the 10 largest vendors (fraction, shown as %).
			// Denominator uses ALL so the KPI stays portfolio-level when a vendor is selected.
			DIVIDE(
			    [Top 10 Vendor Revenue],
			    CALCULATE(SUM(Pareto_Analysis[TotalRevenue]), ALL(Pareto_Analysis))
			)
		formatString: 0.0%
		lineageTag: e5ff92ad-b631-419c-a868-013bc6df594e

	measure 'Healthy SKU %' =
			// Same base as the other health rates: outlier-cleaned vw_PortfolioHealth
			DIVIDE([Healthy SKUs], [SKUs by Health Category])
		formatString: 0.0%
		lineageTag: 329cc954-d65c-47a0-8c5a-f278e03a0b1a

	measure 'Cumulative Revenue %' =
			// Running share of total revenue by vendor rank (source column is in percent units)
			DIVIDE(SUM(Pareto_Analysis[CumulativeRevenuePct]), 100)
		formatString: 0%
		lineageTag: 4abc5e55-d91e-496f-9e3b-a8a735bfbd60

	column Dummy
		dataType: string
		isHidden
		lineageTag: ae6bb0a8-d9b5-46ad-b30d-a091a75af166
		summarizeBy: none
		sourceColumn: Dummy

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

