table _Dynamic_Title_Measure
	lineageTag: c0d1bb7c-38fd-45e3-8bd9-cad0167c5688

	measure 'Selected Vendor Title' =
			
			IF(
			    ISBLANK(SELECTEDVALUE(Vendor_Revenue[VendorName])),
			    "ALL vendors - Portfolio Overview",
			    "Vendor Detail: " & SELECTEDVALUE(Vendor_Revenue[VendorName]))
		lineageTag: 37858950-8545-425f-88d2-6bd1d9258618

	measure 'Selected Vendor Profile' =
			VAR v = SELECTEDVALUE(Vendor_Revenue[VendorName])
			RETURN
			    IF(
			        ISBLANK(v),
			        "Right-click a vendor on any page > Drill through > Vendor Detail",
			        "Rank #" & [Vendor Revenue Rank] & " of " & COUNTROWS(ALL(Vendor_Revenue)) & " by revenue  |  "
			            & SELECTEDVALUE(Vendor_Revenue[TierLabel]) & "  |  "
			            & SELECTEDVALUE(Vendor_Revenue[ParetoBand]) & "  |  "
			            & SELECTEDVALUE(Vendor_Revenue[LeakageSeverity])
			    )
		lineageTag: 7c0f51c7-bf68-402f-b86f-e621c4c51ff0

	column Dummy
		dataType: string
		isHidden
		lineageTag: c8ac8f7c-72b4-474d-a54d-c3b216056f41
		summarizeBy: none
		sourceColumn: Dummy

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Dynamic_Title_Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Dummy = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Dummy", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

