		annotation SummarizationSetBy = Automatic

	partition PackPlays = m
		mode: import
		source =
				let
				    // The newest plays file: the plays are full-year, so the latest month's file is current
				    Source = Folder.Files("C:\Projects\Vendor_Performance_Analysis\pack_output"),
				    PlayFiles = Table.SelectRows(Source, each Text.EndsWith([Name], "_plays.csv")),
				    Newest = Table.First(Table.Sort(PlayFiles, {{"Name", Order.Descending}})),
				    Parsed = Table.PromoteHeaders(Csv.Document(Newest[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    // The risk and excise rows have no dollar values: make those proper blanks
				    Blanks = Table.ReplaceValue(Parsed, "", null, Replacer.ReplaceValue, {"Cautious", "Base", "Stretch"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Kind", type text}, {"Play", type text}, {"Cautious", type number}, {"Base", type number}, {"Stretch", type number}, {"WorksOn", type number}, {"Owner", type text}, {"Priority", type text}, {"Assumptions", type text}}, "en-US"),
				    // Keep the ranked order from the pack: 1 = first row
				    Ordered = Table.AddIndexColumn(Typed, "Order", 1, 1, Int64.Type)
				in
				    Ordered

	annotation PBI_ResultType = Table
