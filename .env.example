# Copy this file to .env and fill in your own values. .env is git-ignored.

# Required for vendor_insights.py
ANTHROPIC_API_KEY=your_key_here

# Optional: SQLAlchemy URL for the analysis notebooks.
# Leave unset to use local SQL Server Express (Vendor_sales) with Windows authentication.
# DB_URL=

# Only for Notebooks/Vendor_Performance_EDA.ipynb (raw CSV ingestion into a MySQL staging database)
# MYSQL_URL=mysql+mysqlconnector://<user>:<password>@127.0.0.1:3306
# RAW_DATA_DIR=C:\path\to\raw\csv\folder
